# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Gemini из Google AI Studio
GEMINI_API_KEY=
# Модель Gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# Запасная модель для повтора, если основная перегружена
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Разрешённые Telegram id через запятую. Пусто = режим настройки (бот сообщает ваш id)
ALLOWED_USER_IDS=
# Путь к базе снов
DATABASE_PATH=data/dreams.db
