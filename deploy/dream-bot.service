[Unit]
Description=Telegram-бот «Сонник»
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dreambot
WorkingDirectory=/opt/dream-bot
ExecStart=/opt/dream-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/dream-bot

[Install]
WantedBy=multi-user.target
